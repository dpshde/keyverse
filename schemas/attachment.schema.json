{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keyverse.local/schemas/attachment.schema.json",
  "title": "keyverse attachment",
  "description": "File (CAS) or URL attachment on a note. See PROTOCOL.md §5.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "kind", "name", "mime", "sha256", "bytes"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[\\w.-]+$",
          "description": "Stable id within the note (att_…)"
        },
        "kind": { "const": "file" },
        "name": { "type": "string", "maxLength": 500 },
        "mime": { "type": "string", "maxLength": 200 },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "Lowercase hex SHA-256 of file bytes; pack path attachments/<sha256>"
        },
        "bytes": { "type": "integer", "minimum": 0 },
        "title": { "type": "string", "maxLength": 500 },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "kind", "url"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[\\w.-]+$"
        },
        "kind": { "const": "url" },
        "url": {
          "type": "string",
          "pattern": "^https?://",
          "description": "Absolute http(s) URL"
        },
        "title": { "type": "string", "maxLength": 500 },
        "created_at": { "type": "string", "format": "date-time" }
      }
    }
  ]
}
