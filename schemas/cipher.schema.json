{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keyverse.local/schemas/cipher.schema.json",
  "title": "keyverse cipher envelope (v1)",
  "description": "Client-side AES-GCM envelope. Server stores opaquely; never decrypts. See PROTOCOL.md §3.1.",
  "type": "object",
  "additionalProperties": true,
  "required": ["salt", "iv", "ct"],
  "properties": {
    "v": {
      "type": "integer",
      "const": 1,
      "description": "Envelope version"
    },
    "alg": {
      "type": "string",
      "const": "AES-GCM",
      "description": "AES-256-GCM"
    },
    "kdf": {
      "type": "string",
      "const": "PBKDF2",
      "description": "PBKDF2-HMAC-SHA-256"
    },
    "iter": {
      "type": "integer",
      "minimum": 1,
      "default": 210000,
      "description": "PBKDF2 iterations (reference client: 210000)"
    },
    "salt": {
      "type": "string",
      "minLength": 1,
      "description": "Base64 16-byte salt"
    },
    "iv": {
      "type": "string",
      "minLength": 1,
      "description": "Base64 12-byte IV"
    },
    "ct": {
      "type": "string",
      "minLength": 1,
      "description": "Base64 ciphertext of UTF-8 JSON {blocks, attachments}"
    }
  }
}
