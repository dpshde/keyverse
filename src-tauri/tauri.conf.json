{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "keyverse",
  "version": "0.1.0",
  "identifier": "dev.dpslabs.keyverse",
  "build": {
    "beforeDevCommand": "node scripts/tauri-ensure-server.mjs",
    "devUrl": "http://127.0.0.1:4180",
    "beforeBuildCommand": "",
    "frontendDist": "../mobile/shell"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "keyverse",
        "width": 420,
        "height": 860,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Lifestyle",
    "shortDescription": "Scripture notes that stay yours",
    "longDescription": "keyverse multipack scripture note door — capture notes by passage address with portable on-disk packs.",
    "iOS": {
      "minimumSystemVersion": "14.0",
      "developmentTeam": ""
    },
    "android": {
      "minSdkVersion": 26
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
