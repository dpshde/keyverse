{
  "name": "keyverse",
  "version": "0.1.0",
  "private": true,
  "description": "keyverse: multipack scripture note door. Primary host is Elixir (mix); web mirror in priv/static; mobile product client in mobile/ (Expo RN).",
  "type": "module",
  "scripts": {
    "start": "mix run --no-halt",
    "dev": "mix run --no-halt",
    "test": "mix test",
    "check": "mix compile --warnings-as-errors",
    "legacy:node": "node server.mjs",
    "extract:client": "node scripts/extract_client_js.mjs",
    "test:e2e:local-mount": "node scripts/e2e-local-mount.mjs",
    "mobile": "npm --prefix mobile start",
    "mobile:ios": "npm --prefix mobile run ios",
    "mobile:android": "npm --prefix mobile run android"
  },
  "dependencies": {
    "grab-bcv": "^0.1.7",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "playwright": "^1.54.2"
  }
}
