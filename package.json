{
  "name": "keyverse",
  "version": "0.1.0",
  "private": true,
  "description": "keyverse: multipack scripture note door. Primary host is Elixir (mix); server.mjs is legacy reference only. Native shells via Tauri v2 (mobile/desktop).",
  "type": "module",
  "scripts": {
    "start": "mix run --no-halt",
    "dev": "mix run --no-halt",
    "test": "mix test",
    "check": "mix compile --warnings-as-errors",
    "legacy:node": "node server.mjs",
    "extract:client": "node scripts/extract_client_js.mjs",
    "test:e2e:local-mount": "node scripts/e2e-local-mount.mjs",
    "icons:tauri": "python3 scripts/gen-tauri-icons.py",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:ios:init": "tauri ios init",
    "tauri:android:init": "tauri android init",
    "tauri:ios:dev": "tauri ios dev",
    "tauri:android:dev": "tauri android dev",
    "tauri:ios:build": "tauri ios build",
    "tauri:android:build": "tauri android build"
  },
  "dependencies": {
    "grab-bcv": "^0.1.7",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "playwright": "^1.54.2"
  }
}
